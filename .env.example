# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables (production).
# Optional extras (Google/GitHub sign-in, model override, …) are listed in the README.

# Postgres. Leave EMPTY locally (embedded database); set it in production.
# Neon (free): https://console.neon.tech → your project → Connection string (pooled)
DATABASE_URL=

# Auth. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# This site's URL: http://localhost:3000 locally, https://<your-app>.vercel.app in production
BETTER_AUTH_URL=http://localhost:3000

# Encrypts users' saved AI keys (32 random bytes, base64; same command as above).
# Never change it once users have saved keys, or they'll have to enter them again.
ENCRYPTION_KEY=

# Admin. Every address listed gets the admin role. The FIRST address is created at
# server start with ADMIN_PASSWORD (min 8 chars); change the password here to reset it.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Gemini key used by admin accounts (free): https://aistudio.google.com/app/apikey
# Other users add their own key in Settings → AI key.
ADMIN_GEMINI_API_KEY=

# Email: password resets and sign-up confirmation, sent from a Gmail account.
# SMTP_PASS is a Gmail APP PASSWORD (turn on 2-Step Verification first):
#   https://myaccount.google.com/apppasswords
# Without these, locally the links are printed in the dev server console.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Trackr <you@gmail.com>
