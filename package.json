{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "predev": "npm run db:migrate",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:import-questions": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/import-questions.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.15",
    "@sparticuz/chromium": "^153.0.0",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.165",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "motion": "^14.10.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.4.0",
    "nuqs": "^2.10.2",
    "postgres": "^4.1.0",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
